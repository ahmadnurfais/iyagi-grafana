GRAFANA_CONTAINER_NAME=iyagi-grafana
LOKI_CONTAINER_NAME=iyagi-loki

GRAFANA_BIND_ADDRESS=127.0.0.1
GRAFANA_PORT=13000

LOKI_BIND_ADDRESS=127.0.0.1
LOKI_PORT=13100
LOKI_RETENTION_PERIOD=8760h

GRAFANA_INTERNAL_NETWORK_NAME=iyagi-grafana-internal
GRAFANA_INGRESS_NETWORK_NAME=iyagi-grafana-ingress

# Optional Telegram alerts. Set the chat ID here and store the bot token in
# secrets/telegram-bot-token. init-grafana.sh enables the Telegram overlay only
# when both values exist.
TELEGRAM_CHAT_ID=
